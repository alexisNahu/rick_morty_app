PORT=3000

# Secretos para firmar los JWT: usar valores largos y aleatorios, distintos entre sí
# (por ejemplo: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change_me
REFRESH_TOKEN=change_me_too

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=rick_morty_db
# Alternativa a las DB_*: DATABASE_URL=postgresql://user:password@host:5432/db
